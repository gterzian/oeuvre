#!/usr/bin/env node
import { mkdir, writeFile } from "node:fs/promises";
import { join } from "node:path";
import {
  connectCDP,
  currentRun,
  dumpBrowserLog,
  environmentDir,
  parseArgs,
  setCurrentRun,
  sleep,
  writeJSON,
} from "./lib.mjs";

const parsed = parseArgs(process.argv.slice(2));
const task = parsed.positional.join(" ").trim();
if (!task) {
  console.error('Usage: scripts/prompt "<task>" --timeout <seconds>');
  process.exit(2);
}
const timeoutSeconds = Number(parsed.options.get("timeout") ?? 120);
const seed = parsed.options.get("seed");
const runMeta = await currentRun();
if (!runMeta?.name) {
  console.error("No launch. Run scripts/launch <name> first.");
  process.exit(2);
}

const { client, jsEval } = await connectCDP();
let finished = false;
let finalReply = "";
let timedOut = false;
let lastStep = -1;

client.onEvent("Agent.stepAdded", (params) => {
  if (params.step !== lastStep) {
    lastStep = params.step;
    process.stdout.write(`\n[step ${params.step}]\n`);
  }
  const text = params.summary ?? "";
  if (params.capturePath) {
    process.stdout.write(`  capture ${params.capturePath}\n`);
  } else if (text) {
    process.stdout.write(`  ${params.kind}: ${text}\n`);
  }
});
client.onEvent("Agent.taskFinished", (params) => {
  finished = true;
  finalReply = params.reply ?? "";
});

await client.send("Agent.startTask", {
  task,
  siteLabel: runMeta.siteLabel ?? runMeta.name,
  seed: seed ?? null,
  url: runMeta.url,
});

const deadline = Date.now() + timeoutSeconds * 1000;
while (!finished && Date.now() < deadline) {
  await sleep(250);
}
if (!finished) {
  timedOut = true;
  await client.send("Agent.stopTask").catch(() => {});
  for (let attempt = 0; attempt < 40 && !finished; attempt += 1) {
    await sleep(100);
  }
}

let state = {};
for (let attempt = 0; attempt < 20; attempt += 1) {
  state = await client.send("Agent.getState");
  if (state.status === "finished" || state.status === "stopped") break;
  await sleep(150);
}
const browserLog = await dumpBrowserLog(client, jsEval);
client.close();

const runDir = state.trajectoryDirectory || join(environmentDir(runMeta.name), "unassigned-run");
await mkdir(runDir, { recursive: true });
const logText = browserLog.map((entry) => JSON.stringify(entry)).join("\n") + (browserLog.length ? "\n" : "");
await writeFile(join(runDir, "app-log.jsonl"), logText);
const record = {
  name: runMeta.name,
  siteLabel: runMeta.siteLabel ?? runMeta.name,
  site: runMeta.site,
  url: runMeta.url,
  task,
  seed: seed ?? null,
  prompt: task,
  startedAt: runMeta.launchedAt,
  finishedAt: new Date().toISOString(),
  timedOut,
  status: state.status,
  finalReply: state.finalReply || finalReply,
  stepCount: state.stepCount ?? 0,
  turnCount: state.turnCount ?? 0,
  steps: state.steps ?? [],
  conversationPath: state.conversationPath ?? "",
  trajectoryDirectory: runDir,
  logPath: join(runDir, "app-log.jsonl"),
  adapter: state.adapter ?? "base",
};
await writeJSON(join(runDir, "record.json"), record);
await writeJSON(join(environmentDir(runMeta.name), "last-run.json"), record);
await setCurrentRun({ ...runMeta, runDir, recordPath: join(runDir, "record.json") });
process.stdout.write(`\n${record.finalReply || "(no final reply)"}\n`);
if (timedOut) {
  console.error(`Timed out after ${timeoutSeconds}s.`);
  process.exit(1);
}
